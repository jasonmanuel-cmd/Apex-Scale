# Apex Scale — environment variables
# Copy this file to `.env` and fill in your values. `.env` is git-ignored.

# --- Neon Postgres connection string ----------------------------------------
# Get this from https://console.neon.tech -> your project -> "Connect".
# It looks like:
#   postgresql://USERNAME:PASSWORD@ep-xxxx-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Paste it below (no quotes needed):
DATABASE_URL=

# --- Server port (optional, defaults to 3333) -------------------------------
# PORT=3333
